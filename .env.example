# Copy this file to .env and fill in real values.
# .env is in .gitignore — never commit real keys.
# In GitHub Actions, add the same names as repository secrets.

FLIGHT_API_KEY=
FLIGHT_API_HOST=aerodatabox.p.rapidapi.com

# Postgres connection (from Neon dashboard)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=

# dbt connection (dbt/aerosydney/profiles.yml). Same Neon database, split into parts.
# In GitHub Actions add PG_HOST, PG_USER, PG_PASSWORD, PG_DATABASE as secrets.
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=
